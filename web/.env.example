# Copie para .env e ajuste. Nenhum valor aqui é segredo: tudo vai para o código público do site.

# Endereço da API (sem barra no final). Em desenvolvimento: http://localhost:8010
VITE_URL_DA_API=http://localhost:8010

# Links dos Google Forms (SPEC §14). Deixe vazio enquanto não existirem.
VITE_URL_FORMULARIO_SUGESTAO=
VITE_URL_FORMULARIO_AVALIACAO=

# ID do Google Analytics 4 (ex.: G-XXXXXXXXXX). Vazio = o Analytics nunca é carregado.
VITE_ID_GOOGLE_ANALYTICS=
