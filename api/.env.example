# Copie para .env e ajuste. Nenhum valor aqui é segredo.

# Domínios que podem chamar a API pelo navegador, separados por vírgula.
RECIRCUITO_ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:4173

# Caminho do arquivo de pontos (relativo à pasta api/).
RECIRCUITO_ARQUIVO_PONTOS=dados/pontos.json

# E-mail de contato enviado ao Nominatim no User-Agent. A política de uso do
# Nominatim exige que o projeto se identifique; troque pelo e-mail real.
RECIRCUITO_CONTATO=seu-email@exemplo.com

# Onde guardar o cache de geocodificação (relativo à pasta api/).
RECIRCUITO_ARQUIVO_CACHE=.cache/geocodificacao.json
